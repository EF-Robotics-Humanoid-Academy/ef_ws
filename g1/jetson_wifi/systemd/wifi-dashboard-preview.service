[Unit]
Description=Unitree Wi-Fi provisioning dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/EF/ef_ws/g1
ExecStart=/usr/bin/python3 /home/unitree/EF/ef_ws/g1/jetson_wifi/dashboard_preview.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/wpa_supplicant

[Install]
WantedBy=multi-user.target
